---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
---

<Layout
    title="404 - Page Not Found"
    description="The page you are looking for does not exist. Return to the homepage of do4you."
>
    <div
        class="flex flex-col justify-center min-h-screen items-center px-5 gap-8 text-center"
    >
        <div class="flex flex-col gap-2">
            <div class="flex flex-col -space-y-2">
                <h1 class="text-9xl font-semibold text-brand-blue">404</h1>
                <h2 class="text-h3 mb-1 text-brand-neutral">Page Not Found</h2>
            </div>
            <p class="text-neutral-10">
                The page you are looking for dose not exist. Go back, or head over to <Button href="/" variant="ghost" underlineAnimation label="Home" class="text-brand-blue" />
            </p>
        </div>

        
    </div>
</Layout>
