---
import { Image } from "astro:assets";
import { process } from "../../data/process";
import ProcessImage from "../../assets/images/process.webp";
import Section from "../ui/Section.astro";
---

<Section id="process">
  <h1 class="text-neutral max-w-2xl text-h2">Our simple process</h1>

  <div class="flex max-lg:flex-col w-full lg:gap-12 items-start">
    <div
      class="lg:sticky top-32 self-start flex-1 bg-radial from-blue-500 to-blue-50 rounded-4xl border border-blue-500 px-8 lg:px-16 "
    >
      <Image
        src={ProcessImage}
        alt="Our Process"
        class="w-full h-auto bottom-0 object-contain"
      />
    </div>

    <div class="flex-1 flex flex-col">
      {
        process.map((step, i) => (
          <div
            class="step flex flex-col gap-4 lg:min-h-[500px] lg:justify-center lg:py-16 max-lg:py-8 max-lg:border-b max-lg:border-blue-100 max-lg:opacity-100 opacity-10 transition-opacity duration-300"
            data-step={i}
          >
            <span class="text-brand-blue font-bold text-sm tracking-widest uppercase">
              Step {i + 1}
            </span>
            <h2 class="text-h3">{step.title}</h2>
            <p class="text-body-lg">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<script>
  const steps = document.querySelectorAll(".step");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          steps.forEach((s) =>
            s.classList.replace("opacity-100", "opacity-10"),
          );
          entry.target.classList.replace("opacity-10", "opacity-100");
        }
      });
    },
    { threshold: 0.8 },
  );

  steps.forEach((step) => observer.observe(step));
</script>
