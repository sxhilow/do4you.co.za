---
import Button from "../ui/Button.astro";
import Whatsapp from "../../assets/icons/Whatsapp.svg";
import Document from "../../assets/icons/Document.svg";
import Walk from "../../assets/icons/Walk.svg";
import { whatsappData } from "../../data/Whatsapp";
import { Image } from "astro:assets";
import HeroImage from "../../assets/images/hero.webp";
---

<section id="#" class=`pt-26 flex flex-col gap-8 -scroll-mt-12`>
    <div
        class="relative bg-neutral-2 border border-blue-100 w-full lg:px-16 lg:py-32 rounded-4xl overflow-hidden flex flex-col lg:block"
    >
        <div
            class="relative z-10 lg:max-w-xl flex flex-col gap-4 max-lg:px-8 max-lg:pt-8"
        >
            <div class="space-y-2">
                <h1 class="text-h1 text-brand-neutral">
                    Need help with your visa forms? <span
                        class="text-brand-blue">Let us handle it.</span
                    >
                </h1>
                <p class="text-brand-neutral">
                    We fill in your visa forms and prepare your documents, so
                    you don't have to worry about mistakes.
                </p>
            </div>
            <div class="w-full">
                <Button
                    href={whatsappData.link}
                    label="WhatsApp us"
                    variant="outline"
                    iconPosition="left"
                    class="max-md:w-full"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Chat with us on WhatsApp"
                >
                    <Whatsapp slot={"icon"} />
                </Button>
            </div>
        </div>

        <div
            class="relative flex mt-8 md:mt-0 lg:absolute lg:right-0 bottom-0 lg:h-full"
        >
            <Image
                src={HeroImage}
                alt="do4you"
                class="w-full aspect-3/4 md:aspect-auto object-cover object-top h-full md:w-auto md:object-contain"
            />
        </div>
        <div
            class="absolute right-5 bottom-8 md:right-20 md:bottom-60 bg-neutral-1 border border-blue-100 rounded-2xl w-54 p-4 flex flex-col gap-1"
        >
            <span class="text-h3 text-brand-blue">500+</span>
            <span class="text-neutral-10"
                >Visa forms completed without any errors</span
            >
            <span class="text-brand-blue">★★★★★</span>
        </div>
    </div>
    <div class="flex max-lg:flex-col gap-4 lg:gap-6">
        <div
            class="flex-1 bg-blue-50 flex gap-2 items-center justify-between p-4 lg:p-8 rounded-2xl border border-blue-200"
        >
            <div class="flex flex-col gap-1">
                <h2 class="text-h3">Send us a Message</h2>
                <p class="text-neutral-10">
                    Send us a message and tell us which visa form you need help
                    with.
                </p>
            </div>
            <Whatsapp class="w-26 h-26 text-brand-blue" />
        </div>
        <div
            class="flex-1 bg-neutral-2 flex gap-4 items-center justify-between p-4 lg:p-8 rounded-2xl border border-neutral-5"
        >
            <div>
                <h2 class="text-h3">We fill in your forms</h2>
                <p class="text-neutral-10">
                    We complete your forms and documents correctly, and book
                    your VFS appointment
                </p>
            </div>
            <Document class="w-32 h-32 text-brand-blue" />
        </div>
        <div
            class="flex-1 bg-blue-50 flex gap-4 items-center justify-between p-4 lg:p-8 rounded-2xl border border-blue-200"
        >
            <div>
                <h2 class="text-h3">Go to VFS & apply</h2>
                <p class="text-neutral-10">
                    Go to your appointment with everything ready. No stress, no
                    mistakes.
                </p>
            </div>
            <Walk class="w-32 h-32 text-brand-blue" />
        </div>
    </div>
</section>
