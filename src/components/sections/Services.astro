---
import ServiceCard from "../ui/ServiceCard.astro";
import { services } from "../../data/services.js";
import Button from "../ui/Button.astro";
import { whatsappData } from "../../data/Whatsapp"

---

<section id="services" class="max-w-7xl mx-auto w-full px-5 my-10 md:my-20 space-y-6 md:space-y-11 scroll-mt-26">

    <h1 class="text-neutral text-h2">What we help you with</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 items-stretch gap-11">
        {
            services.map((service:any) => (
                <ServiceCard
                    image={service.image}
                    title={service.title}
                    description={service.description}
                    items={service.items}
                />
            ))
        }
    </div>

    <div class="w-full p-7 md:p-10 bg-radial-accent rounded-2xl text-center space-y-6">

        <div class="text-h3 max-w-xl mx-auto font-medium">
            Not sure which <span class="text-primary-blue-600 font-bold">visa</span> applies to your situation?
        </div>

        <div>
            <Button
                href={whatsappData.link}
                label="Chat with us"
                classes="rounded-full text-center px-5 py-3 gap-2 bg-primary-blue text-surface hover:bg-primary-blue-900 cursor-pointer text-body-md"
                target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp"
            />
        </div>

    </div>


</section>