---
import ServiceCard from "../ui/ServiceCard.astro";
import { services } from "../../data/services.js";
import Button from "../ui/Button.astro";
import { whatsappData } from "../../data/Whatsapp";
import Section from "../ui/Section.astro";
---

<Section id="services">
    <h1 class="text-neutral text-h2 text-center">What we help you with</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 items-stretch gap-6">
        {
            services.map((service: any) => (
                <ServiceCard
                    price={service.price}
                    image={service.image}
                    title={service.title}
                    description={service.description}
                    items={service.items}
                />
            ))
        }
    </div>

    <div
        class="w-full p-7 md:p-10 bg-radial-[at_50%_25%] from-brand-surface via-blue-50 to-blue-200 rounded-2xl text-center border border-blue-100 space-y-6"
    >
        <div class="text-h3 max-w-xl mx-auto">
            Still have questions? We'll help you <span class="text-brand-blue"
                >figure
            </span> it out.
        </div>

        <div>
            <Button
                href={whatsappData.link}
                label="Get help choosing the right visa"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Chat with us on WhatsApp"
            />
        </div>
    </div>
</Section>
