---
import Button from "../ui/Button.astro";
import Section from "../ui/Section.astro";
import { whatsappData } from "../../data/Whatsapp";
import Whatsapp from "../../assets/icons/Whatsapp.svg";
---

<Section id="problem">
    <div
        class="flex max-lg:flex-col justify-center lg:items-center gap-6 md:gap-11"
    >
        <div class="flex-3/5 rounded-2xl">
            <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                class="rounded-2xl shadow-lg"
            >
                <source src="/visualproblem.mp4" type="video/mp4" />
            </video>
        </div>

        <div class="flex-2/5 flex flex-col space-y-3 md:space-y-6">
            <div class="flex flex-col gap-y-4">
                <h1 class="text-h2 text-neutral">
                    Not sure which visa category applies to you?
                </h1>

                <p class="text-body-lg text-brand-neutral">
                    Looking at all these visa categories is stressful. One small
                    mistake can cause you a big headache. We take away the
                    confusion so you can focus on your time in South Africa.
                    <p></p>
                </p>

                <Button
                    href={whatsappData.link}
                    label="WhatsApp us"
                    variant="filled"
                    iconPosition="left"
                    class="max-md:w-full"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Chat with us on WhatsApp"
                >
                    <Whatsapp slot={"icon"} />
                </Button>
            </div>
        </div>
    </div></Section
>
