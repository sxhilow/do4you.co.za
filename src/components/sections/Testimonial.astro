---
import { reviews } from "../../data/reviews";
import StarFilled from "../../assets/icons/StarFilled.svg";
import StarOutline from "../../assets/icons/StarOutline.svg";
import Section from "../ui/Section.astro";
---

<Section id="reviews">
    <h1 class="text-neutral text-h2 text-center">What people say about us</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 grid-rows-3 gap-6">
        {
            reviews.map((r, i) => (
                <div
                    class={`bg-neutral-2 border border-neutral-5 rounded-2xl p-4 flex flex-col gap-4
                        ${i === 0 ? "row-span-2" : ""}
                        ${i === 2 ? "row-span-2" : ""}
                        ${i === 3 ? "row-span-2" : ""}
                    `}
                >
                    <div class="flex items-center text-brand-blue text-lg">
                        {Array.from({ length: 5 }).map((_, i) =>
                            i < r.stars ? <StarFilled /> : <StarOutline />,
                        )}
                    </div>
                    <p class="text-body text-brand-neutral">"{r.review}"</p>
                    <span class="font-bold text-brand-neutral">— {r.name}</span>
                </div>
            ))
        }
    </div>
</Section>
