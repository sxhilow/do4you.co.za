---
import type { HTMLAttributes } from 'astro/types';

export type ButtonVariants = "ghost" | "outline" | "filled";

interface Props extends HTMLAttributes<'a'>{
    label: string;
    iconPosition?: "right" | "left";
    underlineAnimation?: boolean;
    variant?: ButtonVariants
}

const {
    href,
    label,
    iconPosition = "right",
    underlineAnimation = false,
    variant = "filled",
    class: className,
    ...rest // Capture all other attributes (id, target, etc.)
} = Astro.props;

const baseStyles = "inline-flex items-center justify-center transition duration-300 group aria-[current=page]:text-brand-blue  cursor-pointer"

const variants = {
    "ghost": "font-regular text-neutral hover:text-blue-500",
    "outline": "text-body-md border border-brand-blue text-brand-blue hover:bg-brand-blue hover:text-brand-surface px-4 py-3 gap-2 rounded-lg",
    "filled": "bg-linear-to-b from-brand-blue to-blue-700 text-brand-surface hover:from-blue-500 hover:to-blue-500 px-4 py-3 gap-2 rounded-lg"
}

const activeStyles = [
    className,
    baseStyles,
    variants[variant]
].join(" ");

---

<a href={href} class={activeStyles} {...rest}>

    {iconPosition === "left" && <slot name="icon"/>}

    <span>
        {label}
        {
            underlineAnimation && <span class="block max-w-0 group-hover:max-w-full transition-all duration-300 h-0.5 bg-brand-blue"></span>
        }
    </span>

    {iconPosition === "right" && <slot name="icon"/>}


</a>
