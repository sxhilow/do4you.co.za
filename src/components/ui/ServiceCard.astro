---
import Check from "../../assets/icons/Check.svg";
import Button from "./Button.astro";
import { whatsappData } from "../../data/Whatsapp";
import Whatsapp from "../../assets/icons/Whatsapp.svg";

const { price, title, description, items = [] } = Astro.props;
---

<div
    class="rounded-2xl h-full flex flex-col border border-neutral-5 bg-neutral-2"
>
    <div class="p-4 md:p-7 gap-5 flex flex-col flex-1">
        <div class="space-y-2">
            <h2 class="text-h3 text-brand-blue">{price}</h2>

            <div class="space-y-1">
                <h3 class="text-body-lg font-semibold">{title}</h3>
                <p class="font-light text-body-md">{description}</p>
            </div>
        </div>

        <div class="space-y-6">
            <h4 class="text-body-md font-medium">Everything included:</h4>
            <ul class="space-y-2 text-body-md font-light">
                {
                    items.map((item: any) => (
                        <li class=" flex items-center gap-4">
                            <Check class={"shrink-0"} />
                            <span>{item}</span>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="mt-auto w-full">
            <Button
                href={whatsappData.link}
                label="WhatsApp us"
                variant="outline"
                iconPosition="left"
                class="w-full"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Chat with us on WhatsApp"
            >
                <Whatsapp slot={"icon"} />
            </Button>
        </div>
    </div>
</div>
