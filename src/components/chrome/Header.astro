---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";

const { logo, navItems = [], cta = null } = Astro.props;
---

<header
    id="header"
    class="max-w-[1350px] mx-auto py-6 flex justify-between items-center px-5"
>
    <div class="flex-1">
        <a href="/#">
            <Image src={logo.src} alt={logo.alt} />
        </a>
    </div>

    <nav
        id="nav-links"
        class="flex justify-center items-center gap-10 max-md:hidden flex-1"
    >
        {
            navItems.map((item: any) => (
                <Button
                    href={item.href}
                    label={item.label}
                    variant="ghost"
                    underlineAnimation
                />
            ))
        }
    </nav>

    <div class="flex-1 flex justify-end">
        <Button
            href={cta.href}
            label={cta.label}
            iconPosition="left"
            class="max-md:hidden"
        >
            {
                cta?.icon?.src && (
                    <Image
                        src={cta.icon.src}
                        alt={cta.icon.alt ?? "icon"}
                        slot="icon"
                    />
                )
            }
        </Button>
    </div>

    <div class="md:hidden">
        <button id="menu-btn" class="relative text-white">
            <Image
                id="menu-icon"
                src={cta?.menuIcon?.src}
                alt="menu"
                class="w-10 h-10 transition-all duration-200 opacity-100 rotate-0 scale-100"
            />

            <Image
                id="close-icon"
                src={cta?.closeIcon?.src}
                alt="close"
                class="w-10 h-10 absolute top-0 left-0 transition-all duration-200 opacity-0 rotate-90 scale-0"
            />

            <span class="sr-only">Toggle Menu</span>
        </button>

        <nav
            id="mobile-menu"
            class="hidden bg-brand-surface z-50 left-0 w-full h-screen absolute px-5 mt-2 transition-all duration-150"
        >
            <ul class="mt-10 space-y-3">
                {
                    navItems.map((item: any) => (
                        <a href={item.href} class="group uppercase">
                            <li class="py-3">{item.label}</li>
                        </a>
                    ))
                }
                <li class="mt-5">
                    <Button
                        href={cta.href}
                        label={cta.label}
                        iconPosition="left"
                        class="w-full"
                    >
                        {
                            cta?.icon?.src && (
                                <Image
                                    src={cta.icon.src}
                                    alt={cta.icon.alt ?? "icon"}
                                    slot="icon"
                                />
                            )
                        }
                    </Button>
                </li>
            </ul>
        </nav>
    </div>
</header>

<script is:inline>
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");
    const header = document.getElementById("header");

    function toggleMobileMenu(show) {
        if (show) {
            // OPEN
            mobileMenu.classList.remove("hidden");
            mobileMenu.classList.add("animate-fade-in-from-top");
            mobileMenu.classList.remove("animate-fade-out-from-top");

            menuIcon.classList.add("opacity-0", "rotate-90", "scale-0");
            menuIcon.classList.remove("opacity-100", "rotate-0", "scale-100");

            closeIcon.classList.remove("opacity-0", "rotate-90", "scale-0");
            closeIcon.classList.add("opacity-100", "rotate-0", "scale-100");

            header.classList.add("bg-surface");

            document.body.classList.add("overflow-hidden");
        } else {
            mobileMenu.classList.add("animate-fade-out-from-top");
            mobileMenu.classList.remove("animate-fade-in-from-top");

            setTimeout(() => {
                mobileMenu.classList.add("hidden");
            }, 300);

            menuIcon.classList.remove("opacity-0", "rotate-90", "scale-0");
            menuIcon.classList.add("opacity-100", "rotate-0", "scale-100");

            closeIcon.classList.add("opacity-0", "rotate-90", "scale-0");
            closeIcon.classList.remove("opacity-100", "rotate-0", "scale-100");

            header.classList.remove("bg-surface");

            document.body.classList.remove("overflow-hidden");
        }
    }

    menuBtn.addEventListener("click", () => {
        const isHidden = mobileMenu.classList.contains("hidden");
        toggleMobileMenu(isHidden);
    });

    document.querySelectorAll("#mobile-menu a").forEach((link) => {
        link.addEventListener("click", () => {
            toggleMobileMenu(false);
        });
    });

    const navLinks = document.querySelectorAll("#nav-links a");

    const setActiveLink = () => {
        const currentHash = window.location.hash || "#";
        console.log(currentHash, "Current hash");
        

        navLinks.forEach((link) => {
            console.log("link hash", link.getAttribute("href"));
            
            if (link.getAttribute("href") === currentHash) {
                link.setAttribute("aria-current", "page");
            } else {
                link.removeAttribute("aria-current");
            }
        });
    };

    setActiveLink();

    window.addEventListener("hashchange", setActiveLink)
</script>
