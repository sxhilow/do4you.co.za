---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";

const { logo, tagline, copyright, quickLinks = [] } = Astro.props;
---

<footer class="max-w-[1350px] mx-auto px-5 py-8 lg:py-16">
    <div
        class="flex max-md:flex-col max-md:gap-8 justify-between items-start lg:px-5"
    >
        <div class="flex flex-col gap-2">
            <Image src={logo.src} alt={logo.alt} />

            <p class="md:max-w-lg text-body-md text-neutral-5">
                {tagline}
            </p>
        </div>

        <div class="flex flex-col gap-4">
            <span class="text-neutral-2 font-bold">Quick Links</span>
            <ul class="space-y-1">
                {
                    quickLinks.map((item: any) => (
                        <li class="text-body-md text-neutral-5">
                            <Button
                                href={item.href}
                                label={item.label}
                                variant="ghost"
                                iconPosition="left"
                            />
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <div class="mt-10">
        <hr class="text-blue-700" />

        <div class="flex flex-col justify-center items-center gap-2">
            <p class="block text-neutral-5 text-sm font-light text-center">
                Do4You is an independent service. We are not part of VFS Global or Home Affairs — we simply help you complete your forms correctly.
            </p>
            <p class="text-neutral-5">
                <Button
                    href="/terms"
                    label="Terms & Conditions"
                    variant="ghost"
                />
                |
                <Button
                    href="/privacy"
                    label="Privacy Policy"
                    variant="ghost"
                />
            </p>
        </div>

        <div
            class="mt-12 flex max-md:flex-col gap-2 justify-between items-center text-brand-surface"
        >
            <span>&copy {copyright}</span>
            <div
                class="text-brand-surface hover:text-brand-blue transition duration-300"
            >
                <a href="https://fayda.studio">
                    Designed & Developed by Fayda.studio
                </a>
            </div>
        </div>
    </div>
</footer>
